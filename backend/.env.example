# Thiruvalluvar AI Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database path (relative to backend folder or absolute)
DATABASE_PATH=database/kurals.db

# Ollama / Local LLM (Optional offline AI engine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=3.0

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Rate Limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=40
VOICE_RATE_LIMIT_PER_MINUTE=30
